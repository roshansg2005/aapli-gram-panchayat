{
  "name": "aapli-gram-panchayat-backend",
  "version": "1.0.0",
  "description": "Enterprise Backend API for Aapli Gram Panchayat Digital Platform with Maharashtra LGD database & Role Authentication",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "import-data": "python3 src/scripts/import_lgd_data.py",
    "db:clean-production": "tsx src/scripts/cleanProductionDb.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
